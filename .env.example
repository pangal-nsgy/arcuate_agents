# === Anthropic (required) ===
ANTHROPIC_API_KEY=sk-ant-...

# === Twilio (optional — SMS/WhatsApp) ===
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# === ElevenLabs (optional — voice call transcripts) ===
ELEVENLABS_API_KEY=...

# === Discord (required for Discord bot) ===
DISCORD_BOT_TOKEN=...
# Comma-separated channel names the bot monitors (also responds to DMs + @mentions)
DISCORD_CHANNELS=chief-of-staff,arcuatechat

# === Google OAuth (required for Gmail/Docs ingestion) ===
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json
# For Railway/Docker: paste full JSON string instead of file paths
# GOOGLE_CREDENTIALS_JSON={"installed":...}
# GOOGLE_TOKEN_JSON={"token":...}

# === GitHub (required for code self-modification) ===
GITHUB_TOKEN=ghp_...
GITHUB_REPO=pangal-nsgy/arcuate_agents
GITHUB_BRANCH=claude/mcp-chrome-extension-BW3zj

# === Zoom (optional — not configured) ===
ZOOM_ACCOUNT_ID=...
ZOOM_CLIENT_ID=...
ZOOM_CLIENT_SECRET=...
ZOOM_WEBHOOK_SECRET=...
ZOOM_AUTO_RECORD_INTERNAL=true

# === Recall.ai (optional — meeting bot, not configured) ===
RECALL_API_KEY=...

# === Agent config ===
CHIEF_EMAIL=agent1@arcuatehealth.com
FOUNDER_PHONE_NUMBERS=+1...,+1...,+1...,+1...
MESSAGING_CHANNEL=whatsapp
WEBHOOK_BASE_URL=http://localhost:8000

# === Knowledge store paths ===
CHROMA_PERSIST_DIR=./chroma_data
SQLITE_DB_PATH=./chief_of_staff.db

# === Logging ===
# "json" for structured logs on Railway, "text" for local dev (default: text)
LOG_FORMAT=text

# === Server ===
HOST=0.0.0.0
PORT=8000
