# =============================================================================
# Arcuate Chief of Staff — Environment Variables
# =============================================================================
# Copy to .env and fill in values. See CLAUDE.md for full architecture docs.
#
# REQUIRED vars are marked [REQUIRED] — the app won't function without them.
# Everything else degrades gracefully (tools return errors, features skip).
# =============================================================================

# === Anthropic [REQUIRED] ===
# Claude API key — powers the agent's reasoning loop
ANTHROPIC_API_KEY=sk-ant-...
# Model to use (default: claude-sonnet-4-5-20250929)
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# === Discord [REQUIRED] ===
# Bot token from Discord Developer Portal → Bot → Token
DISCORD_BOT_TOKEN=...
# Set true on exactly one deployment that should respond in Discord.
# Set false on all other workers/deployments to prevent duplicate replies.
ENABLE_DISCORD_BOT=true
# Comma-separated channel names the bot monitors (also responds to DMs + @mentions)
# DISCORD_CHANNELS=chief-of-staff,arcuatechat

# === Google OAuth [REQUIRED for email/docs ingestion] ===
# --- Local development: use file paths ---
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json
# --- Railway/Docker: paste full JSON strings instead of file paths ---
# The app checks for JSON env vars first; if set, they override file paths.
# GOOGLE_CREDENTIALS_JSON={"installed":{"client_id":"...","client_secret":"...",...}}
# GOOGLE_TOKEN_JSON={"token":"...","refresh_token":"...","token_uri":"...","client_id":"...","client_secret":"...","scopes":["..."]}

# === GitHub [REQUIRED for code self-modification] ===
# Fine-grained PAT with Contents read/write permission on the repo
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=pangal-nsgy/arcuate_agents
GITHUB_BRANCH=dev

# === Twilio [optional — enables SMS/WhatsApp tools] ===
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# === ElevenLabs [optional — enables call transcript ingestion] ===
ELEVENLABS_API_KEY=...

# === Zoom [optional — not currently configured] ===
# Server-to-Server OAuth from marketplace.zoom.us
# ZOOM_ACCOUNT_ID=...
# ZOOM_CLIENT_ID=...
# ZOOM_CLIENT_SECRET=...
# ZOOM_WEBHOOK_SECRET=...
# ZOOM_AUTO_RECORD_INTERNAL=true

# === Recall.ai [optional — meeting bot, not currently configured] ===
# RECALL_API_KEY=...

# === Agent Config ===
# Email address the agent sends from (must match Google OAuth account)
CHIEF_EMAIL=agent1@arcuatehealth.com
# Founder phone numbers for SMS/WhatsApp (JSON array format)
FOUNDER_PHONE_NUMBERS=["+1XXXXXXXXXX"]
# "sms" or "whatsapp"
MESSAGING_CHANNEL=sms
# Public URL for webhook callbacks (ngrok for local dev, Railway URL for prod)
WEBHOOK_BASE_URL=http://localhost:8000
# Founder email addresses for CC visibility on agent replies (JSON array format)
FOUNDER_EMAILS=["dan@example.com","dhiraj@arcuatehealth.com"]
# How founders see agent replies to external emails: "cc" or "bcc"
EMAIL_VISIBILITY_MODE=cc
# Google Cloud Pub/Sub subscription name (for webhook authenticity check)
GMAIL_PUBSUB_SUBSCRIPTION=projects/agents-arcuate/subscriptions/gmail-push

# === Knowledge Store Paths ===
# Where ChromaDB stores vector embeddings (gitignored)
CHROMA_PERSIST_DIR=./chroma_data
# Where SQLite stores metadata + activity (gitignored)
SQLITE_DB_PATH=./chief_of_staff.db

# === Agent System Paths ===
# Directory containing agent YAML configs
# AGENTS_DIR=./agents
# Directory containing per-agent memory files
# AGENT_MEMORY_DIR=./agent_memory

# === Logging ===
# "json" for structured logs on Railway, "text" for local dev (default: text)
LOG_FORMAT=text

# === Server ===
HOST=0.0.0.0
PORT=8000
